{
  "name": "ember-debug",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup --config",
    "watch": "pnpm build --watch",
    "prepare": "pnpm build",
    "lint": "pnpm \"/^lint:(?!fix$)[^:]+$/\"",
    "lint:fix": "pnpm \"/^lint:[^:]+:fix$/\" && pnpm format",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:format": "prettier --cache --check \"**/*.{js,cjs,mjs}\"",
    "format": "prettier --cache --write \"**/*.{js,cjs,mjs}\""
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-class-static-block": "^8.0.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "backburner.js": "^2.8.0",
    "glob": "^13.0.6",
    "rollup": "^4.39.0",
    "source-map-js": "^1.2.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./dist/*.js"
  }
}
