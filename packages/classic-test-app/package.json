{
  "name": "classic-test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for classic-test-app goes here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.2",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.2",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@warp-drive/core": "~5.9.1",
    "@warp-drive/json-api": "~5.9.1",
    "@warp-drive/legacy": "~5.9.1",
    "@warp-drive/utilities": "~5.9.1",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.6",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.0.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-data": "~5.9.1",
    "ember-debug": "workspace:*",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.1",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^7.9.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.8.2",
    "globals": "^17.13.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-ember-template-tag": "^2.1.5",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.5.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "webpack": "^5.106.2"
  },
  "engines": {
    "node": ">= 26"
  },
  "ember": {
    "edition": "octane"
  }
}
