{{#if @item.renderNode}}
  <ObjectInspector::Accordion @mixin={{this.accordionMixin}} as |accordion|>
    <div
      class="mixin {{if accordion.isExpanded 'mixin-state-expanded'}} mixin-props-yes"
      data-test-reactivity-pane
      {{did-insert this.requestReactivity}}
      {{did-update this.requestReactivity @item}}
    >
      <h2
        data-test-reactivity-pane-name
        class="mixin-name sticky top-0 truncate select-none cursor-default text-base15 bg-base01"
        role="button"
        {{on "click" accordion.toggle}}
      >
        Reactivity
      </h2>
      {{#if accordion.isExpanded}}
        {{#if this.reactivity}}
          <ul class="mixin-properties m-0 text-base font-mono list-none">
            <li
              class="mixin-property flex relative flex-row items-center truncate"
              data-test-reactivity-update-count
            >
              <span class="mixin-property-name pl-5">re-renders</span>
              <span class="mixin-property-value-txt mr-2">
                {{this.reactivity.updateCount}}
              </span>
            </li>

            {{#if this.causes.length}}
              <li
                class="mixin-property flex relative flex-row items-center truncate"
              >
                <span class="mixin-property-name pl-5">last change caused by</span>
              </li>
              {{#each this.causes as |cause|}}
                <li
                  class="mixin-property flex relative flex-row items-center truncate text-spec01"
                  data-test-reactivity-cause
                >
                  <span class="mixin-property-name pl-5">{{cause}} 🔸</span>
                </li>
              {{/each}}
            {{/if}}

            {{#each this.namedArgs as |arg|}}
              <li
                class="mixin-property flex relative flex-row items-center truncate"
                data-test-reactivity-arg
                title={{arg.debugLabel}}
              >
                <span
                  class="mixin-property-name pl-5 {{if arg.changed 'text-spec01'}}"
                >
                  @{{arg.name}}
                </span>
                <span class="mixin-property-value-txt mr-2 truncate">
                  {{arg.inspect}}
                </span>
                {{#if arg.changed}}🔸{{/if}}
              </li>
              {{#if arg.dependencies.length}}
                <ObjectInspector::DependentKeys @keys={{arg.dependencies}} />
              {{/if}}
            {{/each}}

            {{#each this.positionalArgs as |arg|}}
              <li
                class="mixin-property flex relative flex-row items-center truncate"
                data-test-reactivity-arg
                title={{arg.debugLabel}}
              >
                <span
                  class="mixin-property-name pl-5 {{if arg.changed 'text-spec01'}}"
                >
                  @{{arg.name}}
                </span>
                <span class="mixin-property-value-txt mr-2 truncate">
                  {{arg.inspect}}
                </span>
                {{#if arg.changed}}🔸{{/if}}
              </li>
              {{#if arg.dependencies.length}}
                <ObjectInspector::DependentKeys @keys={{arg.dependencies}} />
              {{/if}}
            {{/each}}

            {{#each this.trackedProps as |prop|}}
              <li
                class="mixin-property flex relative flex-row items-center truncate"
                data-test-reactivity-tracked
                title="revision {{prop.revision}}"
              >
                <span
                  class="mixin-property-name pl-5 {{if prop.changed 'text-spec01'}}"
                >
                  this.{{prop.name}}
                </span>
                {{#if prop.changed}}🔸{{/if}}
              </li>
            {{/each}}
          </ul>
        {{else}}
          <ul class="mixin-properties m-0 text-base font-mono list-none">
            <li class="mixin-property flex relative flex-row items-center truncate">
              Not available for this app
            </li>
          </ul>
        {{/if}}
      {{/if}}
    </div>
  </ObjectInspector::Accordion>
{{/if}}
