{
  "name": "ember-inspector",
  "version": "4.17.0",
  "description": "Extends developer tools to allow you to better inspect your Ember.js apps.",
  "repository": "https://github.com/emberjs/ember-inspector",
  "license": "MIT",
  "author": "Tilde, Inc.",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build --mode development",
    "build:production": "pnpm panes:download && vite build && pnpm extensions:compress",
    "build:test": "EMBER_ENV=test vite build --mode development",
    "panes:download": "EMBER_ENV=production node scripts/download-panes.js",
    "panes:compress": "gulp compress:chrome-pane && gulp compress:firefox-pane && gulp compress:bookmarklet-pane",
    "extensions:compress": "gulp compress:chrome && gulp compress:firefox && gulp clean-tmp",
    "lint": "pnpm \"/^lint:(?!fix$)[^:]+$/\"",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "lint:fix": "pnpm \"/^lint:[^:]+:fix$/\" && pnpm format",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:format": "prettier --cache --check \"**/*.{js,gjs,cjs,mjs}\"",
    "format": "prettier --cache --write \"**/*.{js,gjs,cjs,mjs}\"",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lock-version": "pnpm build:production && pnpm panes:compress",
    "prepublishOnly": "node -e 'process.exit(!require(\"fs\").existsSync(\"./dist\"))' || pnpm build:production",
    "serve:bookmarklet": "pnpm build && vite preview --port 9191",
    "start": "vite",
    "test": "pnpm build:test && pnpm test:ci",
    "test:ci": "testem ci --port 0",
    "watch": "vite build --mode development --watch",
    "watch-test": "EMBER_ENV=test vite --mode development"
  },
  "dependencies": {
    "got": "^11.8.6",
    "rimraf": "^6.1.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.4",
    "@eslint/js": "^9.39.4",
    "@glimmer/component": "^2.2.0",
    "@html-next/vertical-collection": "^5.0.5",
    "@nullvoxpopuli/ember-vite": "^1.3.0",
    "@svg-jar/plugin": "^0.2.2",
    "babel-plugin-debug-macros": "^2.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "basiccontext": "^3.5.1",
    "compare-versions": "^6.1.1",
    "decorator-transforms": "^2.4.0",
    "del": "^6.1.1",
    "ember-debug": "workspace:*",
    "ember-math-helpers": "^5.0.0",
    "ember-modifier": "^4.2.0",
    "ember-primitives": "^0.62.0",
    "ember-qunit": "^9.2.0",
    "ember-raf-scheduler": "^0.5.2",
    "ember-source": "~7.3.1",
    "ember-template-lint": "^6.0.0",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.8.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "flatpickr": "^4.6.13",
    "globals": "^15.14.0",
    "gulp": "^4.0.2",
    "gulp-zip": "^5.1.0",
    "normalize.css": "8.0.1",
    "pretender": "^3.4.7",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.5.0",
    "qunit-theme-ember": "^1.0.0",
    "sass": "^1.79.4",
    "showdown": "^2.1.0",
    "stylelint": "^16.13.2",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^5.0.2",
    "testem": "^3.17.0",
    "tracked-toolbox": "^3.0.0",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "emberVersionsSupported": [
    "3.16.0",
    ""
  ],
  "previousEmberVersionsSupported": [
    "0.0.0",
    "2.7.0",
    "3.4.0"
  ],
  "release-it": {
    "plugins": {
      "release-it-lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": false,
      "tokenRef": "GITHUB_AUTH"
    },
    "npm": {
      "publish": false
    }
  }
}
