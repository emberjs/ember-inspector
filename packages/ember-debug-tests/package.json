{
  "name": "ember-debug-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Runs the ember-debug tests against many ember-source versions",
  "license": "MIT",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "lint": "pnpm \"/^lint:(?!fix$)[^:]+$/\"",
    "lint:fix": "pnpm \"/^lint:[^:]+:fix$/\" && pnpm format",
    "lint:format": "prettier --cache --check \"**/*.{js,cjs,mjs}\"",
    "format": "prettier --cache --write \"**/*.{js,cjs,mjs}\"",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@ember/optional-features": "^3.0.0",
    "@ember/render-modifiers": "^4.0.0",
    "@ember/test-helpers": "^5.4.2",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.2",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "~7.0.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-debug": "workspace:*",
    "ember-load-initializers": "^3.0.1",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.1.0",
    "ember-source": "~7.3.1",
    "ember-source-channel-url": "^3.0.0",
    "ember-try": "^4.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.13.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.4.2",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.4.0",
    "webpack": "^5.97.1"
  },
  "engines": {
    "node": ">= 26"
  },
  "ember": {
    "edition": "octane"
  }
}
